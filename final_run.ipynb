import random
# import tensorflow as tf
from keras.models import Model, Sequential
from keras.layers import Input, Reshape, Dense, Dropout, \
    Activation, LeakyReLU, Conv2D, Conv2DTranspose, \
    Multiply, Embedding, Concatenate, \
    MaxPooling2D, UpSampling2D, Flatten, BatchNormalization
from keras.optimizers import Adam
from keras.preprocessing.image import ImageDataGenerator


X_original = np.load('x_train.npy') #converting  x_train to numpy array

X_real = np.ndarray(shape=(X_original.shape[0], 64, 64, 3)) #resizing x_orignal to 64*64*3
for i in range(X_original.shape[0]):
    X_real[i] = cv2.resize(X_original[i], (64, 64))

y_real = np.load('y_train.npy')
n_classes = y_real.max() - y_real.min() + 1 # number of classes
img_size = X_real[0].shape

# latent space of noise
z = (100,)  #creating latent => compressed data is represented using similar features
optimizer = Adam(learning_rate=0.0002, beta_1=0.5)  #

#print("x-original:",X_original[0:1],"\n x-real:",X_real[0:1],"\n y-real:",y_real[0:1],"\n n_classes:",n_classes,"\n img-size:",img_size,"\n z:",z,"\n optimizer:",optimizer)
Generator

# Build Generator
def generator_conv():
    label = Input((1,), dtype='int32')
    noise = Input(shape=z)

    le = Embedding(n_classes, 100)(label)  #creating layer for labels
    le = Dense(4*4)(le)
    le = Reshape((4, 4, 1))(le)

    noi = Dense(4 * 4 * 256)(noise) #creating layer for noise
    noi = LeakyReLU(alpha=0.3)(noi)
    noi = Reshape((4, 4, 256))(noi)


    merge = Concatenate()([noi, le]) #merging the two
    ## Size: 4 x 4 257

    x = Conv2DTranspose(filters=128,
                        kernel_size=(4, 4),
                        strides=(2, 2),  #strides = scanning of image pixel wise, 2 to left, 2 down = 1 stride
                        padding='same')(merge)  #padding= covering the center pixels to allow same number of strides to each pixel

    x = LeakyReLU(0.2)(x)    #Activation function: Activations are functions that take any real number as input and output a number within a certain range using a non-linear differentiable function.
    # Rectified Linear Unit is an activation function that will output the input directly if it is positive, otherwise, it will output zero. 
    # Leaky ReLU will consider the negative input as well but diminish the impact on the output. 
    ## Size: 8 x 8 x 128

    x = BatchNormalization()(x) #  stablises the data layer after each transformation

    x = Conv2DTranspose(128, (4, 4), strides=(2, 2), padding='same')(x)
    ## Size: 16 x 16 x 128

    x = LeakyReLU(0.2)(x)

    x = BatchNormalization()(x)

    x = Conv2DTranspose(128, (4, 4), strides=(2, 2), padding='same')(x)
    ## Size: 32 x 32 x 128

    x = LeakyReLU(0.2)(x)

    x = BatchNormalization()(x)

    x = Conv2DTranspose(128, (4, 4), strides=(2, 2), padding='same')(x)
    ## Size: 64 x 64 x 128

    x = LeakyReLU(0.2)(x)

    generated = Conv2D(3, (8, 8), padding='same', activation='tanh')(x)
    ## Size: 64 x 64 x 3

    generator = Model(inputs=[noise, label], outputs=generated)
    
    return generator

print(generator_conv.summ)
Discriminator

# Build Discriminator
def discriminator_conv():
    label = Input((1,), dtype='int32')
    img = Input(img_size)

    le = Embedding(n_classes, 100)(label)
    le = Dense(img_size[0] * img_size[1])(le)
    le = Reshape((img_size[0], img_size[1], 1))(le)
    ## Size: 64 x 64 x 1
    merge = Concatenate()([img, le])
    ## Size: 64 x 64 x 4
    x = Conv2D(128, kernel_size=(3, 3), strides=(2, 2), padding='same')(merge)
    x = LeakyReLU(0.2)(x)
    ## Size: 32 x 32 x 128
    # x = BatchNormalization()(x)

    x = Conv2D(128, (3, 3), strides=(2, 2), padding='same')(x)
    x = LeakyReLU(0.2)(x)
    ## Size: 16 x 16 x 128
    # x = BatchNormalization()(x)

    x = Conv2D(128, (3, 3), strides=(2, 2), padding='same')(x)
    x = LeakyReLU(0.2)(x)
    ## Size: 8 x 8 x 128
    # x = BatchNormalization()(x)

    x = Conv2D(128, (3, 3), strides=(2, 2), padding='same')(x)
    x = LeakyReLU(0.2)(x)
    ## Size: 4 x 4 x 128
    # x = BatchNormalization()(x)

    x = Conv2D(128, (3, 3), strides=(2, 2), padding='same')(x)
    x = LeakyReLU(0.2)(x)
    ## Size: 2 x 2 x 128
    # x = BatchNormalization()(x)

    x = Flatten()(x) #merges the dimensions
    x = Dropout(0.4)(x) # drops some feutures to prevent overfitting
    out = Dense(1, activation='sigmoid')(x) # Dense layer is deeply connected with the previous layer , sigmoid activation function gives the output in the range 0,1

    discriminator = Model(inputs=[img, label], outputs=out)
    discriminator.compile(optimizer=optimizer, loss='binary_crossentropy', metrics=['accuracy']) # binary crossentropy returns wheather the image contains a dog image or not
    return discriminator

Trainer for generator and discriminator

def generator_trainer(generator, discriminator):

    discriminator.trainable = False

    gen_noise, gen_label = generator.input
    gen_out = generator.output
    out = discriminator([gen_out, gen_label])
    model = Model([gen_noise, gen_label], out)

    model.compile(optimizer=optimizer, loss='binary_crossentropy')

    return model


Creating a class of GAN and training
# GAN model compiling
class GAN():
    def __init__(self, img_shape=(64, 64, 3), latent_space=(100,)):
        self.img_size = img_shape  # channel_last
        self.z = latent_space
        self.optimizer = Adam(0.0002, 0.5)

        self.gen = generator_conv()
        self.discr = discriminator_conv()

        self.train_gen = generator_trainer(self.gen, self.discr)
        self.loss_D, self.loss_G = [], []

    def train(self, dataset, epochs=50, batch_size=128): #changed epochs=50
        # load data
        imgs, labels = dataset
        imgs = (imgs - 127.5)/127.5
        bs_half = batch_size//2

        for epoch in range(int(epochs)): #changed range(epochs)
            # Get a half batch of random real images
            idx = np.random.randint(0, imgs.shape[0], bs_half)
            real_img, real_label = imgs[idx], labels[idx]

            # Generate a half batch of new images
            noise = np.random.normal(0, 1, size=((bs_half,) + self.z))
            noise_label = np.random.randint(0, n_classes, bs_half)
            fake_img = self.gen.predict([noise, noise_label])

            # real = 1 - np.random.random_sample((bs_half, 1)) * 0.1
            ## One-sided label smoothing
            real = np.random.uniform(0.9, 1.0, (bs_half, 1))
            fake = np.zeros((bs_half, 1))
            ## Random flip 5% labels/data
            mixpoint = int(bs_half * 0.95)
            real = np.concatenate([real[:mixpoint], fake[mixpoint:]])
            fake = np.concatenate([fake[:mixpoint], real[mixpoint:]])
            np.random.shuffle(real)
            np.random.shuffle(fake)

            # Train the discriminator
            loss_fake = self.discr.train_on_batch([fake_img, noise_label], fake)
            loss_real = self.discr.train_on_batch([real_img, real_label], real)
            self.loss_D.append(0.5 * np.add(loss_fake, loss_real))

            # Train the generator
            noise = np.random.normal(0, 1, size=((batch_size,) + self.z))
            noise_label = np.random.randint(0, n_classes, batch_size)
            loss_gen = self.train_gen.train_on_batch([noise, noise_label], np.ones(batch_size))
            self.loss_G.append(loss_gen)

            if ((epoch + 1) * 10) % epochs == 0:
                print('Epoch (%d / %d): [Loss_D_real: %f, Loss_D_fake: %f, acc: %.2f%%] [Loss_G: %f]' %
                  (epoch+1, epochs, loss_real[0], loss_fake[0], 100*self.loss_D[-1][1], loss_gen))

        return


def plt_img(gan):
    r, c = 4, 4
    noise = np.random.normal(0, 1, (r * c, 100))
    noise_label = np.arange(0, c).reshape(-1, 1)
    noise_label = np.dot(noise_label, np.ones((1, r))).astype('int32').T.reshape(-1, 1)
    gen_imgs = gan.gen.predict([noise, noise_label])
    # Rescale images 0 - 1
    gen_imgs = 0.5 * gen_imgs + 0.5
    fig, axs = plt.subplots(r, c)
    cnt = 0
    for i in range(r):
        for j in range(c):
            axs[i,j].imshow(gen_imgs[cnt])
            axs[i,j].set_title("Dog type: %d" % noise_label[cnt])
            axs[i,j].axis('off')
            cnt += 1
    plt.show()
    return

execution
# train GAN
gan = GAN()
LEARNING_STEPS = 150
BATCH_SIZE = 128
# EPOCHS = X_real.shape[0]//BATCH_SIZE
EPOCHS = 300

for learning_step in range(LEARNING_STEPS):
    print('LEARNING STEP # ', learning_step+1, '-'*50)
    gan.train([X_real, y_real], epochs=EPOCHS, batch_size=BATCH_SIZE)
    if (learning_step + 1) % 1 == 0:
        plt_img(gan)

    if (learning_step + 1) % 10 == 0:
        gan.gen.save('cgan_generator_%d_v4.h5' % ((learning_step + 1) * 100))
